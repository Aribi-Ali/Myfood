  commission_amount decimal(10,2) [default: 0.00]
  address text
  latitude decimal(10,8)
  longitude decimal(11,8)
  phone varchar(255)
  notes text
  cancelled_at timestamp
  refunded_at timestamp
  created_at timestamp
  updated_at timestamp
}

Table order_items {
  id bigint [pk, increment]
  order_id bigint
