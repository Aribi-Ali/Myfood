// DBML Schema for dbdiagram.io
// Generated from Laravel migrations

// ======================== CORE ========================

Table users {
  id bigint [pk, increment]
  name varchar(255)
  email varchar(255) [unique]
  email_verified_at timestamp
  password varchar(255)
  phone varchar(255) [unique]
  phone_verified_at timestamp
  role varchar(255) [default: 'client']
  profile_image varchar(255)
  wilaya varchar(255)
  daira varchar(255)
  commune varchar(255)
  delivery_zones json
  address varchar(255)
  latitude decimal(10,8)
  longitude decimal(11,8)
  remember_token varchar(100)
  created_at timestamp
  updated_at timestamp
}

Table password_reset_tokens {
  email varchar(255) [pk]
  token varchar(255)
  created_at timestamp
}

Table sessions {
  id varchar(255) [pk]
  user_id bigint
  ip_address varchar(45)
  user_agent text
  payload longtext
  last_activity int
}

Table personal_access_tokens {
  id bigint [pk, increment]
  tokenable_type varchar(255)
  tokenable_id bigint
  name varchar(255)
  token varchar(64) [unique]
  abilities text
  last_used_at timestamp
  expires_at timestamp
  created_at timestamp
  updated_at timestamp
}

Table notifications {
  id uuid [pk]
  type varchar(255)
  notifiable_type varchar(255)
  notifiable_id bigint
  data text
  read_at timestamp
  created_at timestamp
  updated_at timestamp
}

Table cache {
  key varchar(255) [pk]
  value mediumtext
  expiration int
}

Table cache_locks {
  key varchar(255) [pk]
  owner varchar(255)
  expiration int
}

Table jobs {
  id bigint [pk, increment]
  queue varchar(255)
  payload longtext
  attempts tinyint  
  reserved_at int  
  available_at int  
  created_at int  
}

Table job_batches {
  id varchar(255) [pk]
  name varchar(255)
  total_jobs int
  pending_jobs int
  failed_jobs int
  failed_job_ids longtext
  options mediumtext
  cancelled_at int
  created_at int
  finished_at int
}

Table failed_jobs {
  id bigint [pk, increment]
  uuid varchar(255) [unique]
  connection text
  queue text
  payload longtext
  exception longtext
  failed_at timestamp
}

Table settings {
  id bigint [pk, increment]
  key varchar(255) [unique]
  value text
  type varchar(255) [default: 'string']
  created_at timestamp
  updated_at timestamp
}

// ======================== GEOGRAPHY ========================

Table wilayas {
  id bigint [pk, increment]
  code varchar(3) [unique]
  name_fr varchar(255)
  name_ar varchar(255)
  created_at timestamp
  updated_at timestamp
}

Table dairas {
  id bigint [pk, increment]
  wilaya_id bigint
  name_fr varchar(255)
  name_ar varchar(255)
  created_at timestamp
  updated_at timestamp
}

Table communes {
  id bigint [pk, increment]
  daira_id bigint
  wilaya_id bigint
  name_fr varchar(255)
  name_ar varchar(255)
  created_at timestamp
  updated_at timestamp
}

// ======================== STORES ========================

Table stores {
  id bigint [pk, increment]
  cover_image_id bigint
  main_image_id bigint
  owner_id bigint [unique]
  name varchar(255)
  alias varchar(255) [unique]
  template_slug varchar(50)
  description text
  latitude decimal(11,7)
  longitude decimal(11,7)
  email varchar(255)
  phone varchar(255)
  opening_hours text
  cover_image varchar(255)
  logo_path varchar(255)
  document_path varchar(255)
  wilaya varchar(255)
  daira varchar(255)
  commune varchar(255)
  address varchar(255)
  is_approved boolean [default: false]
  onboarding_status varchar(255) [default: 'pending']
  is_active boolean [default: true]
  avg_prep_time int [default: 25]
  delivery_zone_radius decimal(8,2) [default: 5.00]
  base_delivery_fee int [default: 200]
  avg_delivery_time_per_km int [default: 3]
  ordering_enabled boolean [default: true]
  is_paused boolean [default: false]
  pause_note varchar(255)
  allows_pre_orders boolean [default: false]
  pre_order_lead_time_hours int   [default: 1]
  order_prefix varchar(20)
  order_suffix varchar(20)
  order_padding tinyint   [default: 4]
  order_start_number int   [default: 1]
  break_start timestamp
  break_end timestamp
  break_note text
  theme_preset_id bigint
  is_subscription_managed boolean [default: false]
  created_at timestamp
  updated_at timestamp
}

Table store_images {
  id bigint [pk, increment]
  store_id bigint
  path varchar(255)
  is_cover boolean [default: false]
  created_at timestamp
  updated_at timestamp
}

Table store_social_links {
  id bigint [pk, increment]
  store_id bigint
  platform varchar(50)
  url varchar(255)
  label varchar(255)
  created_at timestamp
  updated_at timestamp
}

Table store_domains {
  id bigint [pk, increment]
  store_id bigint
  domain varchar(255) [unique]
  verification_code varchar(64)
  verified_at timestamp
  is_primary boolean [default: false]
  created_at timestamp
  updated_at timestamp
}

Table store_payouts {
  id bigint [pk, increment]
  store_id bigint
  amount decimal(12,2)
  currency varchar(3) [default: 'DZD']
  status varchar(255) [default: 'pending']
  bank_name varchar(255)
  bank_account varchar(255)
  phone varchar(255)
  notes text
  approved_by bigint
  approved_at timestamp
  paid_at timestamp
  created_at timestamp
  updated_at timestamp
}

Table store_phones {
  id bigint [pk, increment]
  store_id bigint
  phone varchar(30)
  verified_at timestamp
  is_primary boolean [default: false]
  order_index tinyint   [default: 0]
  created_at timestamp
  updated_at timestamp
}

Table store_staff {
  id bigint [pk, increment]
  store_id bigint
  user_id bigint
  store_role varchar(255) [default: 'cashier']
  years_of_experience int
  diplomas varchar(255)
  age int
  bio text
  display_on_profile boolean [default: true]
  permissions text
  created_at timestamp
  updated_at timestamp
}

Table store_badge {
  id bigint [pk, increment]
  store_id bigint
  badge_id bigint
  created_at timestamp
  updated_at timestamp
}

Table badges {
  id bigint [pk, increment]
  name varchar(255)
  description varchar(255)
  color_code varchar(255) [default: '#f97316']
  icon varchar(255)
  created_at timestamp
  updated_at timestamp
}

Table store_type_categories {
  id bigint [pk, increment]
  name varchar(255)
  slug varchar(255) [unique]
  icon varchar(10) [default: '🏪']
  is_active boolean [default: true]
  created_at timestamp
  updated_at timestamp
}

Table store_type_category {
  id bigint [pk, increment]
  store_id bigint
  store_type_category_id bigint
}

Table zones {
  id bigint [pk, increment]
  store_id bigint
  name varchar(255)
  radius_km decimal(8,2)
  fee decimal(8,2)
  created_at timestamp
  updated_at timestamp
}

Table banners {
  id bigint [pk, increment]
  store_id bigint
  image_path varchar(255)
  link_url varchar(255)
  active boolean [default: true]
  created_at timestamp
  updated_at timestamp
}

Table offers {
  id bigint [pk, increment]
  store_id bigint
  title varchar(255)
  description text
  image_path varchar(255)
  valid_from datetime
  valid_to datetime
  active boolean [default: true]
  created_at timestamp
  updated_at timestamp
}

Table posts {
  id bigint [pk, increment]
  store_id bigint
  title varchar(255)
  content text
  image varchar(255)
  created_at timestamp
  updated_at timestamp
}

// ======================== CATEGORIES & FOODS ========================

Table categories {
  id bigint [pk, increment]
  name varchar(255)
  slug varchar(255) [unique]
  image varchar(255)
  short_description varchar(255)
  full_description text
  meta_title varchar(150)
  meta_description text
  meta_keywords varchar(255)
  created_at timestamp
  updated_at timestamp
}

Table foods {
  id bigint [pk, increment]
  store_id bigint
  category_id bigint
  name varchar(255)
  description text
  image varchar(255)
  price decimal(10,2)
  price_usd decimal(10,2)
  price_eur decimal(10,2)
  new_price decimal(10,2)
  new_price_usd decimal(10,2)
  new_price_eur decimal(10,2)
  is_available boolean [default: true]
  is_offer boolean [default: false]
  is_today_special boolean [default: false]
  today_special_expires_at timestamp
  ingredients text
  cooking_time int [default: 15]
  bought_count int [default: 0]
  created_at timestamp
  updated_at timestamp
}

Table food_images {
  id bigint [pk, increment]
  food_id bigint
