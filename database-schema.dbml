}

// ======================== RESERVATIONS ========================

Table reservations {
  id bigint [pk, increment]
  store_reservation_number int  
  store_id bigint
  client_id bigint
  name varchar(255)
  email varchar(255)
  phone varchar(255)
  party_size tinyint  
  reservation_date date
  reservation_time time
  notes text
  special_requests text
  status varchar(255) [default: 'pending']
  cancellation_reason varchar(255)
  cancelled_at timestamp
  created_at timestamp
  updated_at timestamp
}

Table reservation_settings {
  id bigint [pk, increment]
  store_id bigint
  enabled boolean [default: false]
  auto_confirm boolean [default: false]
  manual_confirm boolean [default: true]
  duration_minutes int   [default: 60]
  slot_interval_minutes int   [default: 30]
  min_advance_hours int   [default: 1]
  max_booking_days int   [default: 30]
  min_party_size int   [default: 1]
  max_party_size int   [default: 20]
  allow_notes boolean [default: true]
  allow_special_requests boolean [default: true]
  allow_cancellation boolean [default: true]
  cancellation_deadline_hours int   [default: 2]
  reminder_24h boolean [default: true]
  reminder_2h boolean [default: true]
  created_at timestamp
  updated_at timestamp
}

Table reservation_schedules {
  id bigint [pk, increment]
  store_id bigint
  day_of_week tinyint  
  enabled boolean [default: true]
  open_time time
  close_time time
  created_at timestamp
  updated_at timestamp
}

Table restaurant_tables {
  id bigint [pk, increment]
  store_id bigint
  name varchar(255)
  table_number int  
  capacity int  
  min_capacity int   [default: 1]
  location varchar(255)
  description text
  status varchar(255) [default: 'available']
  created_at timestamp
  updated_at timestamp
}

