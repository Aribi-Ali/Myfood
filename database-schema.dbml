  description text
  is_active boolean [default: true]
  sort_order int [default: 0]
  created_at timestamp
  updated_at timestamp
}

Table plan_features {
  id bigint [pk, increment]
  code varchar(255) [unique]
  name varchar(255)
  description text
  icon varchar(255)
  created_at timestamp
  updated_at timestamp
}

Table plan_feature_assignments {
  id bigint [pk, increment]
  plan_id bigint
  plan_feature_id bigint
  created_at timestamp
  updated_at timestamp
}

Table plan_tiers {
  id bigint [pk, increment]
  plan_id bigint
  name varchar(255)
  min_orders int [default: 0]
  max_orders int
  monthly_price decimal(10,2) [default: 0]
  is_active boolean [default: true]
  sort_order int [default: 0]
  created_at timestamp
  updated_at timestamp
}

Table plan_duration_offers {
  id bigint [pk, increment]
  plan_tier_id bigint
  months int
  discount_percent decimal(5,2) [default: 0]
  discount_label varchar(255)
  is_popular boolean [default: false]
  is_active boolean [default: true]
  created_at timestamp
  updated_at timestamp
}

Table store_subscriptions {
  id bigint [pk, increment]
  store_id bigint [unique]
  plan_tier_id bigint
  plan_duration_offer_id bigint
  status varchar(255) [default: 'trialing']
  trial_ends_at datetime
  start_date datetime
  end_date datetime
  cancelled_at datetime
  monthly_price_snapshot decimal(10,2) [default: 0]
  current_period_orders int [default: 0]
  auto_upgrade boolean [default: true]
  last_tier_check_at datetime
  created_at timestamp
  updated_at timestamp
}

Table billing_invoices {
  id bigint [pk, increment]
  store_subscription_id bigint
  invoice_number varchar(255) [unique]
  period_start datetime
  period_end datetime
  total_orders int [default: 0]
  tier_applied varchar(255)
  plan_name varchar(255)
  base_amount decimal(10,2) [default: 0]
  discount_amount decimal(10,2) [default: 0]
  tax_amount decimal(10,2) [default: 0]
  total_amount decimal(10,2) [default: 0]
  currency varchar(10) [default: 'DZD']
  status varchar(255) [default: 'pending']
  payment_method_type varchar(255)
  gateway_transaction_id varchar(255)
  paid_at datetime
  paid_by_user_id bigint
  notes text
  created_at timestamp
  updated_at timestamp
}

Table payment_gateways {
  id bigint [pk, increment]
  code varchar(255) [unique]
  name varchar(255)
  is_active boolean [default: true]
  config json
  supported_currencies json
  sort_order int [default: 0]
  created_at timestamp
  updated_at timestamp
}

Table payment_methods {
  id bigint [pk, increment]
  store_id bigint
  gateway_id bigint
  type varchar(255)
  details json
  is_default boolean [default: false]
  is_verified boolean [default: false]
  created_at timestamp
  updated_at timestamp
}

// ======================== AI ========================

Table ai_generation_jobs {
  id bigint [pk, increment]
  store_id bigint
  user_id bigint
  type varchar(255)
  input_payload json
  output_payload json
  status varchar(255) [default: 'pending']
  error_message text
  queue_job_id varchar(255)
  completed_at timestamp
  created_at timestamp
  updated_at timestamp
}

