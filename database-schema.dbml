  created_at timestamp
  updated_at timestamp
}

Table category_food {
  food_id bigint
  category_id bigint
}

// ======================== PROMO CODES ========================

Table promo_codes {
  id bigint [pk, increment]
  store_id bigint
  code varchar(255) [unique]
  type varchar(255)
