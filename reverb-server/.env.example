APP_NAME=YallahKoolReverb
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8080

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

BROADCAST_CONNECTION=reverb

REVERB_APP_ID=app-yallahkool
REVERB_APP_KEY=yallahkool-reverb-key
REVERB_APP_SECRET=yallahkool-reverb-secret
REVERB_HOST=0.0.0.0
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

REVERB_SCALING_ENABLED=false

CACHE_STORE=file
SESSION_DRIVER=file
SESSION_SAME_SITE=none
SESSION_LIFETIME=120

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

FRONTEND_URL=http://localhost:3000
